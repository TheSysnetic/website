# Sysnetic — Apache config for the static export (./out)

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 301s from the previous site so existing rankings and links carry over
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteRule ^company\.html$ /company/ [L,R=301]
  RewriteRule ^services\.html$ /services/ [L,R=301]
  RewriteRule ^projects\.html$ /work/ [L,R=301]
  RewriteRule ^contact\.html$ /contact/ [L,R=301]
  RewriteRule ^web-details\.html$ /services/web-development/ [L,R=301]
  RewriteRule ^mobile-details\.html$ /services/mobile-development/ [L,R=301]
  RewriteRule ^aws-details\.html$ /services/cloud-solutions/ [L,R=301]
  RewriteRule ^ui-ux\.html$ /services/ui-ux-design/ [L,R=301]
  RewriteRule ^low-code\.html$ /services/low-code/ [L,R=301]
  RewriteRule ^marketing\.html$ /services/digital-marketing/ [L,R=301]
  RewriteRule ^rpa-details\.html$ /work/reparametrize-ateliers/ [L,R=301]
  RewriteRule ^burakTech\.html$ /work/burak-technologies/ [L,R=301]
  RewriteRule ^productHouse\.html$ /work/product-house/ [L,R=301]
  RewriteRule ^byteForge\.html$ /work/byte-forge-technologies/ [L,R=301]
  RewriteRule ^privacy-policy\.html$ /privacy-policy/ [L,R=301]
  RewriteRule ^terms-conditions\.html$ /terms/ [L,R=301]
  RewriteRule ^page-404\.html$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # hashed build assets never change → cache forever
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|png|jpg|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
